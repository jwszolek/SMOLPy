# The calibrated LS108GP (ADR-0013 to ADR-0016): one packet memory shared by
# its ports, a reserve for each, and one drop state for the whole switch that
# ends once the switch has freed some of it. The port that congests the switch
# loses its frames, in runs, and another port's frames to the same place do
# not: in the drop state a frame is still admitted if it fits in its port's
# reserve.
#
# The testbed of ADR-0011 to ADR-0013, as measured: a TP-Link LS108GP. A
# Raspberry Pi on a 1 Gb/s port sends Poisson UDP traffic of 1518 B frames to
# a laptop on a 100 Mb/s port, at 99.7 % of that port, and is also the Modbus
# TCP server the laptop polls every 10 ms: one station that sends a flow and
# answers polls on its one port. A Waveshare relay module on another 1 Gb/s
# port is polled every 20 ms. Both servers' responses are small, and both
# queue on the laptop's port behind the UDP stream.
#
# The switch stores frames in cells of 128 B, a frame taking ceil(bytes / 128)
# of them: 12 for a UDP frame, 1 for a Modbus response. Each port has a
# reserve of 60 cells, and beyond it the ports share a pool of 710. When a
# frame finds no room, the switch drops every frame that does not fit in its
# port's reserve until it has freed 72 cells, 6 full frames: so the Pi's UDP
# frames are lost in runs of about 6, and its small responses with them, while
# the Waveshare's few frames always fit in its reserve. With two senders both
# lose their frames in the same drop states, as the hardware does. The three
# values were fitted on burst tests, a reserve test and loss runs, and then
# predicted two Pis sending at once at 10 and 100 Mb/s, a 10 Mb/s port, and
# 512 B and mixed frames (docs/backends.md). On the hardware 0.44 % of the Pi's
# polls were retransmitted, none of the Waveshare's, 0.55-0.66 % of the UDP
# frames were lost, in runs of 6.4-6.7 and never alone.
#
# With one sender this is ADR-0015's drop state per port, the same results to
# the frame, and ADR-0014's ingress_buffer=770cells with a resume level 72
# cells lower. ADR-0013's ingress_buffer=60frames gives the same
# numbers for 1518 B frames, but holds 60 frames of any size: three times too
# few 512 B frames, and twelve times too few 64 B ones.
#
# The Modbus metrics observed on each slave count the polls of that slave.
# Replace the switch's limits with buffer=91080, one egress buffer of 60 full
# frames, to see the Waveshare lose responses too. The runs are
# ingress_drops_total / ingress_drop_episodes_total.
#
# It runs headless, so on every backend: --backend rust, or --backend ns3 to
# run the polls over ns-3's TCP, where a lost response is retransmitted
# after about 210 ms instead of timing out.

network "ingress" {

    switch       sw        ports=3 cell=128 pool=710cells ingress_reserve=60cells ingress_drain=72cells ingress_drop=switch
    # ADR-0015: switch sw ports=3 cell=128 pool=716cells ingress_reserve=54cells ingress_drain=72cells
    # ADR-0014: switch sw ports=3 cell=128 ingress_buffer=740cells ingress_resume=668cells
    # ADR-0013: switch sw ports=3 ingress_buffer=60frames
    modbus_slave pi        ip=10.0.0.1 unit_id=1
    modbus_slave waveshare ip=10.0.0.3 unit_id=1
    adapter      laptop    ip=10.0.0.2

    link pi        -- sw speed=1000 length=2
    link waveshare -- sw speed=1000 length=2
    link laptop    -- sw speed=100  length=2

    # 8100 frames/s of 1518 B, 1538 B on the wire: 99.7 % of 100 Mb/s
    flow pi     -> laptop    rate=8100 size=1518 pattern=poisson
    poll laptop -> pi        register=0 count=10 rate=100 outstanding=1 timeout=1000
    poll laptop -> waveshare register=0 count=1  rate=50  outstanding=1 timeout=1000

    observe modbus_latency      on pi        every=10
    observe modbus_timeouts     on pi        every=1000
    observe modbus_timeouts     on waveshare every=1000
    observe frames_sent         on pi        every=1000
    observe ingress_drops_total         on sw every=1000
    observe ingress_drop_episodes_total on sw every=1000
    observe ingress_drop_time_total     on sw every=1000
    observe pool_occupancy              on sw every=1000

    simulate duration=30000 mode=headless
}
